# syntax=docker/dockerfile:1
FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Allow injecting API base URL at build time for Vite
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ARG VITE_MONEYFUSION_TOKEN
ENV VITE_MONEYFUSION_TOKEN=${VITE_MONEYFUSION_TOKEN}
ARG VITE_MONEYFUSION_API_URL
ENV VITE_MONEYFUSION_API_URL=${VITE_MONEYFUSION_API_URL}
ARG VITE_MONEYFUSION_NOTIF_URL
ENV VITE_MONEYFUSION_NOTIF_URL=${VITE_MONEYFUSION_NOTIF_URL}
ARG VITE_FRONTEND_URL
ENV VITE_FRONTEND_URL=${VITE_FRONTEND_URL}
ARG VITE_BACKEND_URL
ENV VITE_BACKEND_URL=${VITE_BACKEND_URL}

COPY . .
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
