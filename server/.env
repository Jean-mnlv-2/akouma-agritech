# Local Development Environment Configuration
# This file is for local development and should NOT be committed to Git.

# Server Configuration
NODE_ENV=development
PORT=4000

# Database URL for local Docker setup
DATABASE_URL="postgresql://postgres:jean@localhost:5432/akouma?schema=public"

# JWT Secret (use a simple one for dev, a strong one for prod)
JWT_SECRET="dev-jwt-secret-for-local-testing-only"

# Frontend Origins for local development
FRONTEND_ORIGINS=http://localhost:8080,http://localhost:5173

# Default Admin User for local database
DEFAULT_ADMIN_EMAIL=admin@akouma.org
DEFAULT_ADMIN_PASSWORD=admin
DEFAULT_ADMIN_FULL_NAME="Local Admin"
DEFAULT_ADMIN_FORCE_RESET=true
