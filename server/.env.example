
# Server Configuration
PORT=4000

# Database URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:jean@db:5432/akouma?schema=public"

# JWT Secret (should be a long, random string)
JWT_SECRET="your-super-secret-jwt-key-with-at-least-32-characters"

# Frontend Origins (comma-separated list of allowed domains)
# Example: FRONTEND_ORIGINS=http://localhost:8080,https://akouma.onrender.com
FRONTEND_ORIGINS=http://localhost:8080,https://akouma.onrender.com

# Default Admin User
DEFAULT_ADMIN_EMAIL=admin@akouma.org
DEFAULT_ADMIN_PASSWORD=yoursecurepassword
DEFAULT_ADMIN_FULL_NAME="AKOUMA Admin"
DEFAULT_ADMIN_FORCE_RESET=false

# Frontend URL (for payment return URLs)
FRONTEND_URL=https://akouma.onrender.com

# Money Fusion Payment Gateway
MONEYFUSION_API_URL=https://pay.moneyfusion.net/Akouma/
MONEYFUSION_TOKEN=your_moneyfusion_token
MONEYFUSION_NOTIF_URL=https://pay.moneyfusion.net/paiementNotif/
