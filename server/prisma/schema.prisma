generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String                @id @default(uuid())
  email            String                @unique
  passwordHash     String
  fullName         String?
  avatarUrl        String?
  role             String                @default("customer")
  isActive         Boolean               @default(true)
  resetToken       String?               @unique
  resetTokenExpiry DateTime?
  allowedModules   String[]              @default([])
  tempPassword     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  enrollments      ELearningEnrollment[]
  orders           Order[]
  reminderLogs     ReminderLog[]
  assignedTasks    Task[]                @relation("TaskAssignedTo")
  createdTasks     Task[]                @relation("TaskCreatedBy")
  reviews          Review[]
}

model Country {
  id        Int      @id @default(autoincrement())
  name      String
  code      String
  phoneCode String
  createdAt DateTime @default(now())
}

model Seed {
  id                   Int      @id @default(autoincrement())
  name                 String
  description          String
  category             String?  @default("Général")
  variety              String?
  price                Decimal  @db.Decimal(12, 2)
  unit                 String?  @default("kg")
  stock                Int      @default(0)
  imageUrl             String?
  availability         String?  @default("En stock")
  harvestTime          String?
  yield                String?
  features             String[] @default([])
  fullDescription      String?
  origin               String?
  purity               String?
  germination          String?
  moisture             String?
  packaging            String?
  soilType             String?
  plantingDepth        String?
  spacing              String?
  watering             String?
  fertilizer           String?
  diseases             String[] @default([])
  plantingInstructions String?
  careInstructions     String?
  rating               Decimal  @default(0) @db.Decimal(2, 1)
  totalReviews         Int      @default(0)
  isPublished          Boolean  @default(false)
  isFeatured           Boolean  @default(false)
  isCopyProtected      Boolean  @default(false)
  gallery              String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  slug                 String   @unique
  reviews              Review[]
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  userId    String
  seedId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seed      Seed     @relation(fields: [seedId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seedId])
}

model Course {
  id                 Int                   @id @default(autoincrement())
  title              String
  description        String?
  content            String?
  price              Decimal               @db.Decimal(12, 2)
  duration           Int?
  level              String?
  thumbnailUrl       String?
  videoUrl           String?
  isPublished        Boolean               @default(false)
  isPreviewAvailable Boolean               @default(false)
  isCopyProtected    Boolean               @default(false)
  languages          String[]              @default(["Français"])
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  slug               String                @unique
  previewItems       CoursePreviewItem[]
  enrollments        ELearningEnrollment[]
}

model News {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  excerpt     String?
  imageUrl    String?
  author      String?
  isPublished Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  isCopyProtected Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique
}

model ShopProduct {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  category    String?
  imageUrl    String?
  gallery     String[] @default([])
  isActive    Boolean  @default(true)
  isPublished Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  isNew       Boolean  @default(false)
  isCopyProtected Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug            String    @unique
  features        String[]  @default([])
  specifications  Json      @default("{}")
}

model LegalPage {
  id            Int      @id @default(autoincrement())
  title         String
  content       String
  slug          String   @unique
  type          String?  @default("legal")
  version       String?  @default("1.0")
  effectiveDate DateTime? @default(now())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Partnership {
  id          Int      @id @default(autoincrement())
  companyName String
  contactName String
  email       String
  phone       String?
  country     String
  message     String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Donation {
  id        Int      @id @default(autoincrement())
  donorName String
  email     String
  amount    Decimal  @db.Decimal(12, 2)
  country   String
  message   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id           Int       @id @default(autoincrement())
  name         String
  email        String
  subject      String?
  message      String
  country      String?
  phone        String?
  company      String?
  project_type String?
  status       String    @default("new")
  processedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ContentSubmission {
  id             Int      @id @default(autoincrement())
  title          String
  content        String
  author         String
  email          String
  phone          String?
  organization   String?
  contentType    String?
  category       String?
  duration       String?
  targetAudience String?
  fileUrl        String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DemoRequest {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  company   String?
  phone     String?
  country   String
  message   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ELearningEnrollment {
  id               Int           @id @default(autoincrement())
  userId           String
  courseId         Int
  enrolledAt       DateTime      @default(now())
  completedAt      DateTime?
  progress         Int           @default(0)
  studyPace        String        @default("standard")
  startDate        DateTime?
  targetEndDate    DateTime?
  remindersEnabled Boolean       @default(true)
  lastReminderSent DateTime?
  studyDays        String?
  dailyTimeSlot    String?
  course           Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderLogs     ReminderLog[]

  @@unique([userId, courseId])
}

model NewsletterSubscription {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Partner {
  id          Int      @id @default(autoincrement())
  name        String
  logo        String?
  logoUrl     String?
  imageUrl    String?
  type        String?
  description String?
  year        String?
  website     String?
  contact     String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique

  @@index([isActive])
  @@index([order])
  @@index([createdAt])
}

model DonationImpact {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  icon        String?
  progress    Int      @default(0)
  target      String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique

  @@index([isActive])
  @@index([order])
  @@index([createdAt])
}

model SuccessStory {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  impact      String
  year        String?
  imageUrl    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique

  @@index([isActive])
  @@index([order])
  @@index([createdAt])
}

/// Live streaming sessions
model LiveStream {
  id              Int       @id @default(autoincrement())
  title           String
  description     String?
  instructorName  String?
  category        String?
  scheduledTime   DateTime?
  durationMinutes Int?
  streamUrl       String?
  thumbnailUrl    String?
  isLive          Boolean   @default(false)
  viewerCount     Int       @default(0)
  maxViewers      Int       @default(0)
  recordingUrl    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  slug            String    @unique
}

/// Simple key/value stats displayed on e-learning pages
model ELearningStat {
  id        Int      @id @default(autoincrement())
  label     String
  value     String
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoursePreviewType {
  id        Int                 @id @default(autoincrement())
  name      String              @unique
  label     String
  icon      String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  items     CoursePreviewItem[]
}

model CoursePreviewItem {
  id          Int               @id @default(autoincrement())
  courseId    Int
  typeId      Int
  type        String
  title       String
  description String?
  contentUrl  String
  duration    String?
  order       Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  previewType CoursePreviewType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([typeId])
  @@index([isActive])
  @@index([order])
}

model ReminderLog {
  id           Int                 @id @default(autoincrement())
  enrollmentId Int
  userId       String
  courseId     Int
  email        String
  status       String              @default("success")
  error        String?
  sentAt       DateTime            @default(now())
  createdAt    DateTime            @default(now())
  enrollment   ELearningEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sentAt])
}

/// Tasks used in supervisor/admin workflows
model Task {
  id             Int      @id @default(autoincrement())
  title          String
  description    String?
  assignedTo     String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assignedToUser User?    @relation("TaskAssignedTo", fields: [assignedTo], references: [id])
  createdByUser  User?    @relation("TaskCreatedBy", fields: [createdBy], references: [id])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  date        DateTime
  location    String
  imageUrl    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique
}

model Career {
  id                  Int              @id @default(autoincrement())
  title               String
  description         String
  requirements        String?
  location            String
  employmentType      String           @default("full-time")
  department          String?
  salaryRange         String?
  isPublished         Boolean          @default(false)
  applicationDeadline DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  slug                String           @unique
  applications        JobApplication[]
}

model JobApplication {
  id          Int      @id @default(autoincrement())
  careerId    Int?
  careerTitle String
  fullName    String
  email       String
  phone       String?
  message     String?
  cvUrl       String?
  attachments String[] @default([])
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  career      Career?  @relation(fields: [careerId], references: [id], onDelete: SetNull)

  @@index([careerId])
  @@index([status])
  @@index([createdAt])
}

/// Contact and social settings (singleton)
model ContactSettings {
  id             Int      @id @default(autoincrement())
  whatsappNumber String?  @map("whatsapp_number") @db.VarChar(100)
  phone          String?  @db.VarChar(100)
  email          String?  @db.VarChar(255)
  addressLine1   String?  @map("address_line1") @db.VarChar(255)
  addressLine2   String?  @map("address_line2") @db.VarChar(255)
  city           String?  @db.VarChar(120)
  country        String?  @db.VarChar(120)
  facebookUrl    String?  @map("facebook_url") @db.VarChar(255)
  instagramUrl   String?  @map("instagram_url") @db.VarChar(255)
  tiktokUrl      String?  @map("tiktok_url") @db.VarChar(255)
  youtubeUrl     String?  @map("youtube_url") @db.VarChar(255)
  linkedinUrl    String?  @map("linkedin_url") @db.VarChar(255)
  xUrl           String?  @map("x_url") @db.VarChar(255)
  websiteUrl     String?  @map("website_url") @db.VarChar(255)
  telegramUrl    String?  @map("telegram_url") @db.VarChar(255)
  supportEmail   String?  @map("support_email") @db.VarChar(255)
  businessHours  String?  @map("business_hours") @db.Text
  mapUrl         String?  @map("map_url") @db.Text
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("contact_settings")
}

model Order {
  id                Int              @id @default(autoincrement())
  userId            String
  orderNumber       String           @unique
  status            String           @default("pending")
  paymentStatus     String           @default("pending")
  paymentMethod     String?
  paymentRef        String?
  deliveryMethod    DeliveryMethod   @default(PICKUP)
  subtotal          Decimal          @db.Decimal(12, 2)
  shipping          Decimal          @default(0) @db.Decimal(12, 2)
  discount          Decimal          @default(0) @db.Decimal(12, 2)
  total             Decimal          @db.Decimal(12, 2)
  shippingAddress   String?
  shippingCity      String?
  shippingCountry   String?
  shippingPhone     String?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  promoCodeId       Int?
  deliveryPartnerId Int?
  deliveryPartner   DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])
  promoCode         PromoCode?       @relation(fields: [promoCodeId], references: [id])
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  events            OrderEvent[]
  items             OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([deliveryPartnerId])
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  productId   Int
  productType String
  name        String
  price       Decimal  @db.Decimal(12, 2)
  quantity    Int
  imageUrl    String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id            Int      @id @default(autoincrement())
  orderId       Int
  type          String
  status        String?
  paymentStatus String?
  note          String?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model PromoCode {
  id            Int               @id @default(autoincrement())
  code          String            @unique
  description   String?
  discountType  PromoDiscountType @default(PERCENTAGE)
  discountValue Decimal           @db.Decimal(12, 2)
  maxUses       Int?
  usesCount     Int               @default(0)
  isActive      Boolean           @default(true)
  validFrom     DateTime?
  validUntil    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  orders        Order[]

  @@index([isActive])
  @@index([code])
  @@index([validFrom])
  @@index([validUntil])
}

model DeliveryPartner {
  id             Int      @id @default(autoincrement())
  name           String
  description    String?
  contactName    String?
  phone          String?
  email          String?
  website        String?
  baseRate       Decimal? @db.Decimal(12, 2)
  estimatedDelay String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]

  @@index([isActive])
  @@index([createdAt])
}

enum PromoDiscountType {
  PERCENTAGE
  FIXED
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}
