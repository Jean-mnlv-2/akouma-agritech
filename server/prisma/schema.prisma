generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                 @id @default(uuid())
  email                   String                 @unique
  passwordHash            String
  fullName                String?
  avatarUrl               String?
  role                    String                 @default("customer")
  isActive                Boolean                @default(true)
  resetToken              String?                @unique
  resetTokenExpiry        DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  allowedModules          String[]               @default([])
  phone                   String?
  hasUsedTrial            Boolean                @default(false)
  comments                CourseComment[]
  schedules               CourseSchedule[]
  enrollments             ELearningEnrollment[]
  moduleProgress          ModuleProgress[]
  orders                  Order[]
  pushSubscriptions       PushSubscription[]
  reminderLogs            ReminderLog[]
  rattrapageRequests      RattrapageRequest[]
  reviews                 Review[]
  assignedTasks           Task[]                 @relation("TaskAssignedTo")
  createdTasks            Task[]                 @relation("TaskCreatedBy")
  certificates            Certificate[]
  chatThreads             ChatThread[]
  chatDailyBudgets        ChatDailyBudget[]
  subscription            Subscription?
  invoices                Invoice[]
  subscriptionTransactions SubscriptionTransaction[]
  subscriptionNotifications SubscriptionNotification[]
}

model Country {
  id        Int      @id @default(autoincrement())
  name      String
  code      String
  phoneCode String
  createdAt DateTime @default(now())
}

model Seed {
  id                   Int      @id @default(autoincrement())
  name                 String
  description          String
  price                Decimal  @db.Decimal(12, 2)
  stock                Int      @default(0)
  imageUrl             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  slug                 String   @unique
  availability         String?  @default("En stock")
  careInstructions     String?
  category             String?  @default("Général")
  diseases             String[] @default([])
  features             String[] @default([])
  fertilizer           String?
  fullDescription      String?
  germination          String?
  harvestTime          String?
  moisture             String?
  origin               String?
  packaging            String?
  plantingDepth        String?
  plantingInstructions String?
  purity               String?
  rating               Decimal  @default(0) @db.Decimal(2, 1)
  soilType             String?
  spacing              String?
  totalReviews         Int      @default(0)
  unit                 String?  @default("kg")
  variety              String?
  watering             String?
  yield                String?
  isFeatured           Boolean  @default(false)
  isPublished          Boolean  @default(false)
  isCopyProtected      Boolean  @default(false)
  gallery              String[] @default([])
  reviews              Review[]
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  userId    String
  seedId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seed      Seed     @relation(fields: [seedId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seedId])
}

model Course {
  id                 Int                   @id @default(autoincrement())
  title              String
  description        String?
  content            String?
  price              Decimal               @db.Decimal(12, 2)
  duration           Int?
  level              String?
  category           String?               @default("Agriculture")
  instructorName     String?
  instructorBio      String?
  thumbnailUrl       String?
  videoUrl           String?
  isPublished        Boolean               @default(false)
  isPreviewAvailable Boolean               @default(false)
  languages          String[]              @default(["Français"])
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  slug               String                @unique
  isCopyProtected    Boolean               @default(false)
  // Planification automatique de cohorte : quand les deux sont renseignés,
  // la date d'ouverture de chaque module actif se calcule seule
  // (cohortStartDate + module.order * cohortIntervalDays jours) — zéro
  // saisie manuelle par module. Un module.openDate explicite reste
  // prioritaire s'il est renseigné (permet une exception ponctuelle).
  cohortStartDate    DateTime?
  cohortIntervalDays Int?
  // Provenance : "admin" (créé manuellement) ou "deerflow" (brouillon créé
  // par l'automatisation) — permet au rapport hebdomadaire de compter
  // précisément l'activité de DeerFlow, sans quoi rien ne distinguait un
  // brouillon automatisé d'un brouillon manuel inachevé.
  createdVia         String                @default("admin")
  sertifierDesignId        String?
  sertifierDetailId        String?
  sertifierEmailTemplateId String?
  comments           CourseComment[]
  modules            CourseModule[]
  previewItems       CoursePreviewItem[]
  schedules          CourseSchedule[]
  enrollments        ELearningEnrollment[]
  certificates       Certificate[]
}

model CourseModule {
  id            Int              @id @default(autoincrement())
  courseId      Int
  title         String
  type          String           @default("text")
  duration      String?
  content       String?
  videoUrl      String?
  pdfUrl        String?
  order         Int              @default(0)
  isActive      Boolean          @default(true)
  quizQuestions Json?
  // null = pas de cohorte, verrouillage séquentiel classique par apprenant
  // inchangé ; renseigné = module verrouillé pour TOUT LE MONDE jusqu'à
  // cette date (progression par cohorte, cf. RattrapageRequest).
  openDate      DateTime?
  // Provenance (voir Course.createdVia) — même rationale.
  createdVia    String           @default("admin")
  // Santé des liens vidéo/PDF, vérifiée par le rapport hebdomadaire (pas de
  // vérification en temps réel côté apprenant — coûteux et inutile à chaque
  // chargement de page).
  linkBroken        Boolean      @default(false)
  linkLastCheckedAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  comments      CourseComment[]
  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress      ModuleProgress[]
  rattrapageRequests     RattrapageRequest[] @relation("RattrapageOriginalModule")
  rattrapageAlternateFor RattrapageRequest[] @relation("RattrapageAlternateModule")

  @@index([courseId])
  @@index([order])
  @@index([courseId, openDate])
}

model CourseComment {
  id         Int             @id @default(autoincrement())
  courseId   Int
  moduleId   Int?
  userId     String
  content    String
  parentId   Int?
  isApproved Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  course     Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module     CourseModule?   @relation(fields: [moduleId], references: [id])
  parent     CourseComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies    CourseComment[] @relation("CommentReplies")
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([moduleId])
  @@index([userId])
  @@index([parentId])
}

model CourseSchedule {
  id            Int                 @id @default(autoincrement())
  enrollmentId  Int
  userId        String
  courseId      Int
  scheduledDate DateTime
  timeSlot      String
  status        String              @default("scheduled")
  isLocked      Boolean             @default(false)
  attendedAt    DateTime?
  absenceCount  Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  course        Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment    ELearningEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([userId])
  @@index([courseId])
  @@index([scheduledDate])
}

model ModuleProgress {
  id           Int                 @id @default(autoincrement())
  enrollmentId Int
  moduleId     Int
  userId       String
  completed    Boolean             @default(false)
  quizScore    Int?
  completedAt  DateTime?
  // Reprise vidéo/PDF propre à CE module — ELearningEnrollment.videoPositionSec/
  // pdfPage restent en base pour compat mais ne sont plus la source de vérité
  // dès qu'un moduleId est fourni à PUT /elearning_enrollments/:id/state.
  videoPositionSec Int             @default(0)
  pdfPage      Int                 @default(1)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  enrollment   ELearningEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  module       CourseModule        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, moduleId])
  @@index([userId])
}

model News {
  id              Int      @id @default(autoincrement())
  title           String
  content         String
  excerpt         String?
  imageUrl        String?
  author          String?
  category        String?  @default("Général")
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  slug            String   @unique
  isFeatured      Boolean  @default(false)
  isCopyProtected Boolean  @default(false)

  /// New fields for auto-news / DeerFlow
  sourceType      String?  @default("manual") @db.VarChar(50) // "manual" or "auto"
  sourceName      String?  @db.VarChar(255)
  sourceUrl       String?  @db.VarChar(500)
  scrapedAt       DateTime?
  keywords        String[] @default([])
  language        String?  @db.VarChar(50) @default("fr")
  originalId      String?  @db.VarChar(255) // Unique ID from source to prevent duplicates
}

// Produits phytosanitaires — base structurée dédiée (formulaire admin
// professionnel), distincte du modèle `Document` générique. Champs pensés
// pour un filtrage RAG strict et exact (culture + ravageur/maladie ciblés)
// plutôt qu'une recommandation par similarité textuelle vague.
// `commercialName` EST indexé (KilimoKnowledgeAdapter.indexPhytosanitaryProducts)
// mais le RAG (RagWorkflow) ne le cite que si le produit correspond
// EXACTEMENT à la culture/au problème de la question — sinon aucun nom
// commercial ni produit spécifique n'est mentionné, seulement la matière
// active en général.
model PhytosanitaryProduct {
  id                 String   @id @default(uuid())
  activeIngredient   String // matière active — identifiant principal du produit
  productType        String // "Herbicide" | "Fongicide" | "Insecticide" | "Acaricide" | "Nématicide" | "Régulateur de croissance" | "Autre"
  targetCrops        String[] // cultures ciblées, ex: ["Cacao","Maïs"]
  targetPests        String[] // ravageurs/maladies/adventices ciblés, ex: ["Mirides","Pourriture brune"]
  description        String // mode d'action, description technique
  dosage             String?
  applicationMethod  String?
  preHarvestInterval String? // délai avant récolte (DAR)
  safetyPrecautions  String?
  regulatoryStatus   String   @default("homologué") // "homologué" | "restreint" | "en évaluation" | "retiré"
  commercialName     String? // usage interne admin uniquement — jamais indexé pour le RAG
  tier               String   @default("standard") // "standard" | "premium" — gate RAG comme Document.tier
  // Citations vérifiables (centre de recherche, institution, étude) — voir
  // Document.sources pour la justification complète. Particulièrement
  // important ici : contenu réglementaire/sécurité, jamais activé sans
  // pouvoir en vérifier l'origine.
  sources            Json?
  region             String? // ex: "Afrique", "Cameroun" — voir Document.region
  isActive           Boolean  @default(true)
  isIndexed          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Sources RSS/scraping gérées par l'admin (UI dans AdminNews/AdminEvents >
// Sources & Automatisation) au lieu d'un fichier de config codé en dur —
// permet d'ajouter/désactiver une source sans déploiement, avec validation
// stricte côté serveur (URL testée avant sauvegarde, catégorie/langue/type
// limités à un enum fermé) pour éviter une prolifération de sources mal
// formées. Santé (lastStatus/lastError/consecutiveFailures) persistée ici
// plutôt qu'en mémoire : survit aux redémarrages du serveur.
//
// `contentType` distingue actualités et événements : le moteur de scraping
// (fetch RSS/web) est identique pour les deux, mais la sauvegarde diverge —
// un événement exige une date/lieu réels, jamais devinés (voir
// NewsScraperService.saveEvent : extraction JSON-LD schema.org uniquement,
// aucun événement créé si aucune date structurée n'est trouvée).
//
// `scheduleTimes` : horaires "HH:MM" (heure serveur) auxquels cette source
// doit être scrapée automatiquement, gérés par le scheduler KILIMO
// (server/src/utils/sourceScheduler.ts) plutôt que de dépendre de DeerFlow
// (processus externe, pas garanti actif à un instant précis). Liste vide =
// aucune automatisation, déclenchement manuel/DeerFlow uniquement.
model NewsSource {
  id                  Int       @id @default(autoincrement())
  name                String
  url                 String    @unique
  type                String // "rss" | "web"
  contentType         String    @default("news") // "news" | "event"
  language            String // "fr" | "en"
  category            String
  enabled             Boolean   @default(true)
  scheduleTimes       String[]  @default([])
  lastStatus          String? // "ok" | "not_modified" | "error"
  lastError           String?
  lastRunAt           DateTime?
  lastArticleCount    Int       @default(0)
  consecutiveFailures Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

