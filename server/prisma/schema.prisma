model ReminderLog {
  id           Int                 @id @default(autoincrement())
  enrollmentId Int
  userId       String
  courseId     Int
  // Renseigné uniquement pour les rappels de rattrapage (type="rattrapage_reminder").
  moduleId     Int?
  email        String
  status       String              @default("success")
  // "learning_pace" (défaut, comportement du rappel quotidien existant
  // inchangé) | "rattrapage_reminder" (nouveau, dédupliqué via l'index ci-dessous).
  type         String              @default("learning_pace")
  error        String?
  sentAt       DateTime            @default(now())
  createdAt    DateTime            @default(now())
  enrollment   ELearningEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sentAt])
  @@index([enrollmentId, moduleId, type])
}

// Demande de rattrapage : soumise par l'apprenant quand la fenêtre
// d'évaluation d'un module est fermée sans qu'il l'ait validé, résolue par
// un admin (le rattrapage n'est pas forcément le même quiz — l'admin peut
// assigner alternateModuleId). La validation, quelle que soit sa source,
// est toujours enregistrée sur le module d'origine (moduleId) pour que
// l'admissibilité à l'examen de synthèse reste cohérente.
model RattrapageRequest {
  id                Int      @id @default(autoincrement())
  enrollmentId      Int
  moduleId          Int
  userId            String
  courseId          Int
  status            String   @default("pending") // pending | granted | rejected | completed
  requestedAt       DateTime @default(now())
  resolvedAt        DateTime?
  resolvedBy        String?
  resolutionNote    String?
  alternateModuleId Int?
  // Brouillon de résolution proposé par DeerFlow (jamais appliqué seul —
  // l'admin reste le seul à pouvoir accorder/refuser via PUT /:id).
  suggestedResolution String?
  suggestedByAi        Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  enrollment      ELearningEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  module          CourseModule        @relation("RattrapageOriginalModule", fields: [moduleId], references: [id], onDelete: Cascade)
  alternateModule CourseModule?       @relation("RattrapageAlternateModule", fields: [alternateModuleId], references: [id])
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, moduleId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
}

// Table générique pour toutes les suggestions rédigées par DeerFlow qui
// nécessitent une validation humaine — relance de présence, revue de quiz,
// planification de cohorte, traduction de contenu. Une seule table plutôt
// que 4 quasi-identiques : chaque type sait quoi faire de son `payload` Json
// à l'application (voir server/src/routes/aiSuggestions.ts).
model AiSuggestion {
  id         Int       @id @default(autoincrement())
  type       String    // 'attendance_outreach' | 'quiz_review' | 'cohort_schedule' | 'translation'
  targetType String    // 'enrollment' | 'module' | 'course'
  targetId   Int
  title      String    // libellé court pour la liste admin
  payload    Json      // contenu spécifique au type (texte suggéré, question corrigée, intervalle, traduction…)
  status     String    @default("pending") // pending | applied | dismissed
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([type])
  @@index([status])
  @@index([targetType, targetId])
}

/// Tasks used in supervisor/admin workflows
model Task {
  id             Int      @id @default(autoincrement())
  title          String
  description    String?
  assignedTo     String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assignedToUser User?    @relation("TaskAssignedTo", fields: [assignedTo], references: [id])
  createdByUser  User?    @relation("TaskCreatedBy", fields: [createdBy], references: [id])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  date        DateTime
  location    String
  imageUrl    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique
}

model Career {
  id                  Int              @id @default(autoincrement())
  title               String
  description         String
  requirements        String?
  location            String
  employmentType      String           @default("full-time")
  department          String?
  salaryRange         String?
  isPublished         Boolean          @default(false)
  applicationDeadline DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  slug                String           @unique
  applications        JobApplication[]
}

model JobApplication {
  id          Int      @id @default(autoincrement())
  careerId    Int?
  careerTitle String
  fullName    String
  email       String
  phone       String?
  message     String?
  cvUrl       String?
  attachments String[] @default([])
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  career      Career?  @relation(fields: [careerId], references: [id])

  @@index([careerId])
  @@index([status])
  @@index([createdAt])
}

/// Contact and social settings (singleton)
model ContactSettings {
  id             Int      @id @default(autoincrement())
  whatsappNumber String?  @map("whatsapp_number") @db.VarChar(100)
  phone          String?  @db.VarChar(100)
  email          String?  @db.VarChar(255)
  addressLine1   String?  @map("address_line1") @db.VarChar(255)
  addressLine2   String?  @map("address_line2") @db.VarChar(255)
  city           String?  @db.VarChar(120)
  country        String?  @db.VarChar(120)
  facebookUrl    String?  @map("facebook_url") @db.VarChar(255)
  instagramUrl   String?  @map("instagram_url") @db.VarChar(255)
  tiktokUrl      String?  @map("tiktok_url") @db.VarChar(255)
  youtubeUrl     String?  @map("youtube_url") @db.VarChar(255)
  linkedinUrl    String?  @map("linkedin_url") @db.VarChar(255)
  xUrl           String?  @map("x_url") @db.VarChar(255)
  websiteUrl     String?  @map("website_url") @db.VarChar(255)
  telegramUrl    String?  @map("telegram_url") @db.VarChar(255)
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")
  businessHours  String?  @map("business_hours")
  mapUrl         String?  @map("map_url")
  supportEmail   String?  @map("support_email") @db.VarChar(255)

  @@map("contact_settings")
}

model Order {
  id                   Int                   @id @default(autoincrement())
  userId               String
  subscriptionPlanId   String?
  orderNumber          String                @unique
  status               String                @default("pending")
  paymentStatus        String                @default("pending")
  paymentMethod        String?
  deliveryMethod       DeliveryMethod        @default(PICKUP)
  subtotal             Decimal               @db.Decimal(12, 2)
  shipping             Decimal               @default(0) @db.Decimal(12, 2)
  discount             Decimal               @default(0) @db.Decimal(12, 2)
  cashbackUsed         Decimal               @default(0) @db.Decimal(12, 2)
  cashbackPromoCodeId  Int?
  total                Decimal               @db.Decimal(12, 2)
  shippingAddress      String?
  shippingCity         String?
  shippingCountry      String?
  shippingPhone        String?
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  promoCodeId          Int?
  deliveryPartnerId    Int?
  paymentRef           String?
  deliveryId           String?               @unique
  deliveryStatus       String?               @default("pending")
  shippingState        String?
  shippingZipCode      String?
  reminderSentAt       DateTime?
  // Renseignés uniquement pour un item productType="course" — reportés sur
  // l'ELearningEnrollment créée automatiquement après paiement (voir
  // OrdersService.processPostPayment), pour éviter de redemander ces infos
  // après coup puisque l'utilisateur est déjà authentifié avant l'achat.
  professionalActivity String?
  organization         String?
  sector               String?
  experienceLevel      String?
  expectations         String?
  cashbackTransactions CashbackTransaction[]
  deliveryPartner      DeliveryPartner?      @relation(fields: [deliveryPartnerId], references: [id])
  promoCode            PromoCode?            @relation(fields: [promoCodeId], references: [id])
  cashbackPromoCode    PromoCode?            @relation("OrderCashbackUsage", fields: [cashbackPromoCodeId], references: [id])
  subscriptionPlan     Plan?                 @relation("PlanOrderPurchases", fields: [subscriptionPlanId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  events               OrderEvent[]
  items                OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([deliveryPartnerId])
  @@index([subscriptionPlanId])
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  productId   Int
  productType String
  name        String
  price       Decimal  @db.Decimal(12, 2)
  quantity    Int
  imageUrl    String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id            Int      @id @default(autoincrement())
  orderId       Int
  type          String
  status        String?
  paymentStatus String?
  note          String?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model PromoCode {
  id                  Int                   @id @default(autoincrement())
  code                String                @unique
  description         String?
  discountType        PromoDiscountType     @default(PERCENTAGE)
  discountValue       Decimal               @db.Decimal(12, 2)
  maxUses             Int?
  usesCount           Int                   @default(0)
  isActive            Boolean               @default(true)
  validFrom           DateTime?
  validUntil          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  ownerEmail          String?
  ownerName           String?
  cashbackPercent     Decimal               @default(0) @db.Decimal(5, 2)
  cashbackBalance     Decimal               @default(0) @db.Decimal(12, 2)
  totalCashbackEarned Decimal               @default(0) @db.Decimal(12, 2)
  transactions        CashbackTransaction[]
  orders              Order[]
  cashbackOrders      Order[]               @relation("OrderCashbackUsage")

  @@index([isActive])
  @@index([code])
  @@index([validFrom])
  @@index([validUntil])
}

model CashbackTransaction {
  id           Int       @id @default(autoincrement())
  promoCodeId  Int
  type         String    @default("EARN")
  amount       Decimal   @db.Decimal(12, 2)
  description  String?
  orderId      Int?
  balanceAfter Decimal   @default(0) @db.Decimal(12, 2)
  createdAt    DateTime  @default(now())
  order        Order?    @relation(fields: [orderId], references: [id])
  promoCode    PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@index([promoCodeId])
  @@index([createdAt])
}

model DeliveryPartner {
  id             Int      @id @default(autoincrement())
  code           String   @unique @default("manual")
  name           String
  description    String?
  contactName    String?
  phone          String?
  email          String?
  website        String?
  baseRate       Decimal? @db.Decimal(12, 2)
  estimatedDelay String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]

  @@index([isActive])
  @@index([code])
  @@index([createdAt])
}

enum PromoDiscountType {
  PERCENTAGE
  FIXED
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

model Certificate {
  id                Int       @id @default(autoincrement())
  userId            String
  courseId          Int
  enrollmentId      Int?
  certificateNumber String    @unique
  score             Int?
  completionDate    DateTime  @default(now())
  status            String    @default("pending") // pending | processing | sent | failed
  attempts          Int       @default(0)
  lastError         String?
  campaignId        String?
  credentialId      String?
  credentialUrl     String?
  issuedAt          DateTime?
  executionLog      Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course            Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
}

model PageHeaderImage {
  id        Int      @id @default(autoincrement())
  pageKey   String
  imageUrl  String
  altText   String?
  title     String?
  subtitle  String?
  ctaLabel  String?
  ctaUrl    String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageKey])
  @@index([isActive])
  @@index([order])
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model WebhookNonce {
  id        Int      @id @default(autoincrement())
  source    String
  nonce     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([source, nonce])
  @@index([expiresAt])
}

model ChatThread {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("Nouvelle conversation")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String     @id @default(uuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
}

model CookieConsent {
  id          String   @id @default(uuid())
  userId      String?
  anonId      String
  version     String
  necessary   Boolean  @default(true)
  analytics   Boolean  @default(false)
  marketing   Boolean  @default(false)
  preferences Boolean  @default(false)
  method      String   // "accept_all" | "reject_all" | "custom" | "revoked"
  ipHash      String?
  userAgent   String?
  url         String?
  locale      String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([anonId, createdAt])
  @@index([createdAt])
}

// ==========================================
// Subscription & Plan Management
// ==========================================

/// Subscription Plan definition
model Plan {
  id                      String   @id @default(uuid())
  name                    String   @unique
  displayName             String
  description             String?
  price                   Decimal  @db.Decimal(12, 2) // Monthly price
  currency                String   @default("XOF")
  dailyProMessageLimit    Int      @default(0) // 0 = unlimited
  hasCustomDocuments      Boolean  @default(false)
  hasPrioritySupport      Boolean  @default(false)
  hasApiAccess            Boolean  @default(false)
  maxCustomDocuments      Int      @default(0) // 0 = unlimited
  trialDays               Int      @default(0)
  isActive                Boolean  @default(true)
  sortOrder               Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  subscriptions           Subscription[]
  orders                  Order[]  @relation("PlanOrderPurchases")

  @@index([isActive, sortOrder])
}

/// User subscription
model Subscription {
  id                      String                 @id @default(uuid())
  userId                  String
  planId                  String
  status                  String                 @default("active") // active, cancelled, expired, past_due
  startDate               DateTime               @default(now())
  endDate                 DateTime?
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  trialStartDate          DateTime?
  trialEndDate            DateTime?
  isTrial                 Boolean                @default(false)
  autoRenew               Boolean                @default(true)
  paymentMethodId         String?
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  metadata                Json?                  @default("{}")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                    Plan                   @relation(fields: [planId], references: [id], onDelete: Cascade)
  invoices                Invoice[]
  transactions            SubscriptionTransaction[]

  @@unique([userId])
  @@index([userId])
  @@index([status])
  @@index([planId])
}

/// Subscription invoice
model Invoice {
  id                  String         @id @default(uuid())
  subscriptionId      String
  userId              String
  amount              Decimal        @db.Decimal(12, 2)
  currency            String         @default("XOF")
  status              String         @default("pending") // pending, paid, failed, cancelled
  dueDate             DateTime
  paidAt              DateTime?
  pdfUrl              String?
  invoiceNumber       String         @unique
  metadata            Json?          @default("{}")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  subscription        Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([userId])
  @@index([status])
  @@index([dueDate])
}

/// Subscription payment transaction
model SubscriptionTransaction {
  id                  String         @id @default(uuid())
  subscriptionId      String
  userId              String
  amount              Decimal        @db.Decimal(12, 2)
  currency            String         @default("XOF")
  type                String         // payment, refund, failed
  paymentMethod       String?
  transactionRef      String?
  status              String         @default("pending")
  metadata            Json?          @default("{}")
  createdAt           DateTime       @default(now())

  subscription        Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([userId])
  @@index([createdAt])
}

/// Subscription notification
model SubscriptionNotification {
  id                  String   @id @default(uuid())
  userId              String
  type                String   // trial_ending, renewal_reminder, payment_failed, expired
  sentAt              DateTime @default(now())
  isRead              Boolean  @default(false)
  metadata            Json?    @default("{}")

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sentAt])
}

/// Subscription analytics (summary)
model SubscriptionAnalytics {
  id                  String   @id @default(uuid())
  date                DateTime @db.Date
  totalSubscribers    Int      @default(0)
  newSubscriptions    Int      @default(0)
  cancelledSubscriptions Int  @default(0)
  revenue             Decimal  @default(0) @db.Decimal(12, 2)
  currency            String   @default("XOF")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

// ==========================================
// Chatbot Budget Tracking
// ==========================================

/// Tracks daily chat message usage per user
model ChatDailyBudget {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime @db.Date
  freeUsage   Int      @default(0) // Usage with only free sources (Seed, Course, News)
  proUsage    Int      @default(0) // Usage that included custom documents
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// ==========================================
// RAG Module - Knowledge Models
// ==========================================

/// Represents a knowledge source (document, article, course, etc.)
model KnowledgeSource {
  id          String            @id @default(uuid())
  title       String
  content     String
  contentType String           @default("text")
  sourceType  String            @default("manual") // manual, course, seed, news
  metadata    Json              @default("{}")
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  chunks      KnowledgeChunk[]

  @@index([sourceType, isActive])
  @@index([createdAt])
}

/// Custom documents for RAG system
model Document {
  id          String   @id @default(uuid())
  title       String
  content     String   // Text content of the document (typed manually or extracted from pdfUrl)
  description String?
  sourceType  String   @default("manual") // manual, guide, pdf, etc.
  tier        String   @default("standard") // "standard" | "premium" — gates access in RagWorkflow/chat.ts
  pdfUrl      String?  // Original uploaded PDF, kept for reference/download; text extracted into `content` for RAG (images in the PDF are not searchable, no vision model configured)
  metadata    Json     @default("{}")
  // Citations vérifiables (centre de recherche, institution, étude — nom +
  // URL/référence optionnelle) : { name: string, url?: string }[]. Permet à
  // un admin de vérifier la crédibilité d'un contenu avant de l'activer,
  // en particulier pour les brouillons rédigés par DeerFlow. Volontairement
  // typé Json plutôt qu'une table dédiée : simple liste de citations, jamais
  // interrogée indépendamment du document parent.
  sources     Json?
  // Portée géographique du contenu (ex: "Afrique", "Cameroun", "Afrique de
  // l'Ouest") — texte libre, pas un enum fermé de pays.
  region      String?
  isActive    Boolean  @default(true)
  isIndexed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Registre admin des centres de recherche/institutions de confiance (IITA,
/// CORAF, IRAD Cameroun, FAO, INRAB...) dont DeerFlow doit prioritairement
/// s'inspirer pour rédiger les brouillons Document/PhytosanitaryProduct —
/// consulté en lecture seule via /api/internal/knowledge-base/trusted-sources.
/// Gère l'attente inverse de Document.sources : là où sources cite la/les
/// références utilisées PAR un document donné, TrustedSource définit EN
/// AMONT la liste que DeerFlow est censé consulter.
model TrustedSource {
  id          Int      @id @default(autoincrement())
  name        String   // ex: "IITA", "IRAD Cameroun", "FAO"
  url         String?
  description String?
  region      String?  // ex: "Afrique", "Cameroun", "Afrique de l'Ouest"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

// Abonnement Web Push (PWA installée) — endpoint unique par navigateur/
// appareil. userId nullable : un visiteur peut s'abonner sans compte, on
// relie l'abonnement à son compte s'il se connecte plus tard.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Represents a chunk of knowledge with vector embedding
model KnowledgeChunk {
  id         String         @id @default(uuid())
  sourceId   String
  content   String
  metadata  Json         @default("{}")
  embedding Unsupported("vector(768)")?
  chunkIndex Int
  createdAt  DateTime     @default(now())
  source    KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([chunkIndex])
}
