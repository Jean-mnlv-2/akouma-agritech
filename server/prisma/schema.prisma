generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String                @id @default(uuid())
  email            String                @unique
  passwordHash     String
  fullName         String?
  avatarUrl        String?
  role             String                @default("customer")
  isActive         Boolean               @default(true)
  resetToken       String?               @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  allowedModules   String[]              @default([])
  phone            String?
  comments         CourseComment[]
  schedules        CourseSchedule[]
  enrollments      ELearningEnrollment[]
  moduleProgress   ModuleProgress[]
  orders           Order[]
  reminderLogs     ReminderLog[]
  reviews          Review[]
  assignedTasks    Task[]                @relation("TaskAssignedTo")
  createdTasks     Task[]                @relation("TaskCreatedBy")
  certificates     Certificate[]
  chatThreads      ChatThread[]
}

model Country {
  id        Int      @id @default(autoincrement())
  name      String
  code      String
  phoneCode String
  createdAt DateTime @default(now())
}

model Seed {
  id                   Int      @id @default(autoincrement())
  name                 String
  description          String
  price                Decimal  @db.Decimal(12, 2)
  stock                Int      @default(0)
  imageUrl             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  slug                 String   @unique
  availability         String?  @default("En stock")
  careInstructions     String?
  category             String?  @default("Général")
  diseases             String[] @default([])
  features             String[] @default([])
  fertilizer           String?
  fullDescription      String?
  germination          String?
  harvestTime          String?
  moisture             String?
  origin               String?
  packaging            String?
  plantingDepth        String?
  plantingInstructions String?
  purity               String?
  rating               Decimal  @default(0) @db.Decimal(2, 1)
  soilType             String?
  spacing              String?
  totalReviews         Int      @default(0)
  unit                 String?  @default("kg")
  variety              String?
  watering             String?
  yield                String?
  isFeatured           Boolean  @default(false)
  isPublished          Boolean  @default(false)
  isCopyProtected      Boolean  @default(false)
  gallery              String[] @default([])
  reviews              Review[]
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  userId    String
  seedId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seed      Seed     @relation(fields: [seedId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seedId])
}

model Course {
  id                 Int                   @id @default(autoincrement())
  title              String
  description        String?
  content            String?
  price              Decimal               @db.Decimal(12, 2)
  duration           Int?
  level              String?
  category           String?               @default("Agriculture")
  instructorName     String?
  instructorBio      String?
  thumbnailUrl       String?
  videoUrl           String?
  isPublished        Boolean               @default(false)
  isPreviewAvailable Boolean               @default(false)
  languages          String[]              @default(["Français"])
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  slug               String                @unique
  isCopyProtected    Boolean               @default(false)
  sertifierDesignId        String?
  sertifierDetailId        String?
  sertifierEmailTemplateId String?
  comments           CourseComment[]
  modules            CourseModule[]
  previewItems       CoursePreviewItem[]
  schedules          CourseSchedule[]
  enrollments        ELearningEnrollment[]
  certificates       Certificate[]
}

model CourseModule {
  id            Int              @id @default(autoincrement())
  courseId      Int
  title         String
  type          String           @default("text")
  duration      String?
  content       String?
  videoUrl      String?
  pdfUrl        String?
  order         Int              @default(0)
  isActive      Boolean          @default(true)
  quizQuestions Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  comments      CourseComment[]
  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress      ModuleProgress[]

  @@index([courseId])
  @@index([order])
}

model CourseComment {
  id         Int             @id @default(autoincrement())
  courseId   Int
  moduleId   Int?
  userId     String
  content    String
  parentId   Int?
  isApproved Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  course     Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module     CourseModule?   @relation(fields: [moduleId], references: [id])
  parent     CourseComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies    CourseComment[] @relation("CommentReplies")
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([moduleId])
  @@index([userId])
  @@index([parentId])
}

model CourseSchedule {
  id            Int                 @id @default(autoincrement())
  enrollmentId  Int
  userId        String
  courseId      Int
  scheduledDate DateTime
  timeSlot      String
  status        String              @default("scheduled")
  isLocked      Boolean             @default(false)
  attendedAt    DateTime?
  absenceCount  Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  course        Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment    ELearningEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([userId])
  @@index([courseId])
  @@index([scheduledDate])
}

model ModuleProgress {
  id           Int                 @id @default(autoincrement())
  enrollmentId Int
  moduleId     Int
  userId       String
  completed    Boolean             @default(false)
  quizScore    Int?
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  enrollment   ELearningEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  module       CourseModule        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, moduleId])
  @@index([userId])
}

model News {
  id              Int      @id @default(autoincrement())
  title           String
  content         String
  excerpt         String?
  imageUrl        String?
  author          String?
  category        String?  @default("Général")
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  slug            String   @unique
  isFeatured      Boolean  @default(false)
  isCopyProtected Boolean  @default(false)

  /// New fields for auto-news / DeerFlow
  sourceType      String?  @default("manual") @db.VarChar(50) // "manual" or "auto"
  sourceName      String?  @db.VarChar(255)
  sourceUrl       String?  @db.VarChar(500)
  scrapedAt       DateTime?
  keywords        String[] @default([])
  language        String?  @db.VarChar(50) @default("fr")
  originalId      String?  @db.VarChar(255) // Unique ID from source to prevent duplicates
}

model ShopProduct {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  price           Decimal  @db.Decimal(12, 2)
  stock           Int      @default(0)
  category        String?
  imageUrl        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  slug            String   @unique
  isFeatured      Boolean  @default(false)
  isNew           Boolean  @default(false)
  isPublished     Boolean  @default(false)
  isCopyProtected Boolean  @default(false)
  gallery         String[] @default([])
  features        String[] @default([])
  specifications  Json     @default("{}")
}

model LegalPage {
  id            Int       @id @default(autoincrement())
  title         String
  content       String
  slug          String    @unique
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  effectiveDate DateTime? @default(now())
  type          String?   @default("legal")
  version       String?   @default("1.0")
}

model Partnership {
  id          Int      @id @default(autoincrement())
  companyName String
  contactName String
  email       String
  phone       String?
  country     String
  message     String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Donation {
  id        Int      @id @default(autoincrement())
  donorName String
  email     String
  amount    Decimal  @db.Decimal(12, 2)
  country   String
  message   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id           Int       @id @default(autoincrement())
  name         String
  email        String
  subject      String?
  message      String
  country      String?
  phone        String?
  company      String?
  project_type String?
  status       String    @default("new")
  processedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ContentSubmission {
  id             Int      @id @default(autoincrement())
  title          String
  content        String
  author         String
  email          String
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  category       String?
  contentType    String?
  duration       String?
  fileUrl        String?
  organization   String?
  phone          String?
  targetAudience String?
}

model DemoRequest {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  company   String?
  phone     String?
  country   String
  message   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ELearningEnrollment {
  id                   Int              @id @default(autoincrement())
  userId               String
  courseId             Int
  enrolledAt           DateTime         @default(now())
  completedAt          DateTime?
  progress             Int              @default(0)
  studyPace            String           @default("standard")
  startDate            DateTime?
  targetEndDate        DateTime?
  remindersEnabled     Boolean          @default(true)
  lastReminderSent     DateTime?
  studyDays            String?
  dailyTimeSlot        String?
  professionalActivity String?
  organization         String?
  sector               String?
  experienceLevel      String?
  expectations         String?
  currentModuleId      Int?
  videoPositionSec     Int              @default(0)
  pdfPage              Int              @default(1)
  lastAccessedAt       DateTime?
  schedules            CourseSchedule[]
  course               Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleProgress       ModuleProgress[]
  reminderLogs         ReminderLog[]

  @@unique([userId, courseId])
}

model NewsletterSubscription {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Partner {
  id          Int      @id @default(autoincrement())
  name        String
  logo        String?
  logoUrl     String?
  imageUrl    String?
  type        String?
  description String?
  year        String?
  website     String?
  contact     String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique

  @@index([isActive])
  @@index([order])
  @@index([createdAt])
}

model DonationImpact {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  icon        String?
  progress    Int      @default(0)
  target      String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique

  @@index([isActive])
  @@index([order])
  @@index([createdAt])
}

model SuccessStory {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  impact      String
  year        String?
  imageUrl    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique

  @@index([isActive])
  @@index([order])
  @@index([createdAt])
}

/// Live streaming sessions
model LiveStream {
  id              Int       @id @default(autoincrement())
  title           String
  description     String?
  instructorName  String?
  category        String?
  scheduledTime   DateTime?
  durationMinutes Int?
  streamUrl       String?
  thumbnailUrl    String?
  isLive          Boolean   @default(false)
  viewerCount     Int       @default(0)
  maxViewers      Int       @default(0)
  recordingUrl    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  slug            String    @unique
}

/// Simple key/value stats displayed on e-learning pages
model ELearningStat {
  id        Int      @id @default(autoincrement())
  label     String
  value     String
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoursePreviewType {
  id        Int                 @id @default(autoincrement())
  name      String              @unique
  label     String
  icon      String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  items     CoursePreviewItem[]
}

model CoursePreviewItem {
  id          Int               @id @default(autoincrement())
  courseId    Int
  typeId      Int
  type        String
  title       String
  description String?
  contentUrl  String
  duration    String?
  order       Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  previewType CoursePreviewType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([typeId])
  @@index([isActive])
  @@index([order])
}

model ReminderLog {
  id           Int                 @id @default(autoincrement())
  enrollmentId Int
  userId       String
  courseId     Int
  email        String
  status       String              @default("success")
  error        String?
  sentAt       DateTime            @default(now())
  createdAt    DateTime            @default(now())
  enrollment   ELearningEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sentAt])
}

/// Tasks used in supervisor/admin workflows
model Task {
  id             Int      @id @default(autoincrement())
  title          String
  description    String?
  assignedTo     String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assignedToUser User?    @relation("TaskAssignedTo", fields: [assignedTo], references: [id])
  createdByUser  User?    @relation("TaskCreatedBy", fields: [createdBy], references: [id])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  date        DateTime
  location    String
  imageUrl    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique
}

model Career {
  id                  Int              @id @default(autoincrement())
  title               String
  description         String
  requirements        String?
  location            String
  employmentType      String           @default("full-time")
  department          String?
  salaryRange         String?
  isPublished         Boolean          @default(false)
  applicationDeadline DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  slug                String           @unique
  applications        JobApplication[]
}

model JobApplication {
  id          Int      @id @default(autoincrement())
  careerId    Int?
  careerTitle String
  fullName    String
  email       String
  phone       String?
  message     String?
  cvUrl       String?
  attachments String[] @default([])
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  career      Career?  @relation(fields: [careerId], references: [id])

  @@index([careerId])
  @@index([status])
  @@index([createdAt])
}

/// Contact and social settings (singleton)
model ContactSettings {
  id             Int      @id @default(autoincrement())
  whatsappNumber String?  @map("whatsapp_number") @db.VarChar(100)
  phone          String?  @db.VarChar(100)
  email          String?  @db.VarChar(255)
  addressLine1   String?  @map("address_line1") @db.VarChar(255)
  addressLine2   String?  @map("address_line2") @db.VarChar(255)
  city           String?  @db.VarChar(120)
  country        String?  @db.VarChar(120)
  facebookUrl    String?  @map("facebook_url") @db.VarChar(255)
  instagramUrl   String?  @map("instagram_url") @db.VarChar(255)
  tiktokUrl      String?  @map("tiktok_url") @db.VarChar(255)
  youtubeUrl     String?  @map("youtube_url") @db.VarChar(255)
  linkedinUrl    String?  @map("linkedin_url") @db.VarChar(255)
  xUrl           String?  @map("x_url") @db.VarChar(255)
  websiteUrl     String?  @map("website_url") @db.VarChar(255)
  telegramUrl    String?  @map("telegram_url") @db.VarChar(255)
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")
  businessHours  String?  @map("business_hours")
  mapUrl         String?  @map("map_url")
  supportEmail   String?  @map("support_email") @db.VarChar(255)

  @@map("contact_settings")
}

model Order {
  id                   Int                   @id @default(autoincrement())
  userId               String
  orderNumber          String                @unique
  status               String                @default("pending")
  paymentStatus        String                @default("pending")
  paymentMethod        String?
  deliveryMethod       DeliveryMethod        @default(PICKUP)
  subtotal             Decimal               @db.Decimal(12, 2)
  shipping             Decimal               @default(0) @db.Decimal(12, 2)
  discount             Decimal               @default(0) @db.Decimal(12, 2)
  total                Decimal               @db.Decimal(12, 2)
  shippingAddress      String?
  shippingCity         String?
  shippingCountry      String?
  shippingPhone        String?
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  promoCodeId          Int?
  deliveryPartnerId    Int?
  paymentRef           String?
  deliveryId           String?               @unique
  deliveryStatus       String?               @default("pending")
  shippingState        String?
  shippingZipCode      String?
  cashbackTransactions CashbackTransaction[]
  deliveryPartner      DeliveryPartner?      @relation(fields: [deliveryPartnerId], references: [id])
  promoCode            PromoCode?            @relation(fields: [promoCodeId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  events               OrderEvent[]
  items                OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([deliveryPartnerId])
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  productId   Int
  productType String
  name        String
  price       Decimal  @db.Decimal(12, 2)
  quantity    Int
  imageUrl    String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id            Int      @id @default(autoincrement())
  orderId       Int
  type          String
  status        String?
  paymentStatus String?
  note          String?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model PromoCode {
  id                  Int                   @id @default(autoincrement())
  code                String                @unique
  description         String?
  discountType        PromoDiscountType     @default(PERCENTAGE)
  discountValue       Decimal               @db.Decimal(12, 2)
  maxUses             Int?
  usesCount           Int                   @default(0)
  isActive            Boolean               @default(true)
  validFrom           DateTime?
  validUntil          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  ownerEmail          String?
  ownerName           String?
  cashbackPercent     Decimal               @default(0) @db.Decimal(5, 2)
  cashbackBalance     Decimal               @default(0) @db.Decimal(12, 2)
  totalCashbackEarned Decimal               @default(0) @db.Decimal(12, 2)
  transactions        CashbackTransaction[]
  orders              Order[]

  @@index([isActive])
  @@index([code])
  @@index([validFrom])
  @@index([validUntil])
}

model CashbackTransaction {
  id           Int       @id @default(autoincrement())
  promoCodeId  Int
  type         String    @default("EARN")
  amount       Decimal   @db.Decimal(12, 2)
  description  String?
  orderId      Int?
  balanceAfter Decimal   @default(0) @db.Decimal(12, 2)
  createdAt    DateTime  @default(now())
  order        Order?    @relation(fields: [orderId], references: [id])
  promoCode    PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@index([promoCodeId])
  @@index([createdAt])
}

model DeliveryPartner {
  id             Int      @id @default(autoincrement())
  code           String   @unique @default("manual")
  name           String
  description    String?
  contactName    String?
  phone          String?
  email          String?
  website        String?
  baseRate       Decimal? @db.Decimal(12, 2)
  estimatedDelay String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]

  @@index([isActive])
  @@index([code])
  @@index([createdAt])
}

enum PromoDiscountType {
  PERCENTAGE
  FIXED
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

model Certificate {
  id                Int       @id @default(autoincrement())
  userId            String
  courseId          Int
  enrollmentId      Int?
  certificateNumber String    @unique
  score             Int?
  completionDate    DateTime  @default(now())
  status            String    @default("pending") // pending | processing | sent | failed
  attempts          Int       @default(0)
  lastError         String?
  campaignId        String?
  credentialId      String?
  credentialUrl     String?
  issuedAt          DateTime?
  executionLog      Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course            Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
}

model PageHeaderImage {
  id        Int      @id @default(autoincrement())
  pageKey   String
  imageUrl  String
  altText   String?
  title     String?
  subtitle  String?
  ctaLabel  String?
  ctaUrl    String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageKey])
  @@index([isActive])
  @@index([order])
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model WebhookNonce {
  id        Int      @id @default(autoincrement())
  source    String
  nonce     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([source, nonce])
  @@index([expiresAt])
}

model ChatThread {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("Nouvelle conversation")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String     @id @default(uuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
}

model CookieConsent {
  id          String   @id @default(uuid())
  userId      String?
  anonId      String
  version     String
  necessary   Boolean  @default(true)
  analytics   Boolean  @default(false)
  marketing   Boolean  @default(false)
  preferences Boolean  @default(false)
  method      String   // "accept_all" | "reject_all" | "custom" | "revoked"
  ipHash      String?
  userAgent   String?
  url         String?
  locale      String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([anonId, createdAt])
  @@index([createdAt])
}
